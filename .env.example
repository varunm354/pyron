# Optional: AI-generated answers in "Ask NASA research".
# Copy to .env (gitignored) and fill in BOTH values, then restart the server.
# Leave them empty to use evidence search only.
# This is your own OpenAI API key; a Cursor subscription does not provide one.
OPENAI_API_KEY=
# A model available to your OpenAI account that supports structured outputs (JSON schema).
OPENAI_MODEL=
